# qianli-netlog 配置（.env 不进 git；本文件为模板）
# ---- 部署目标（NAS_* 为历史命名，语义=部署目标小电脑 DESKTOP-FE1MIGI；push.js 消费）----
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=mechax
DEPLOY_PASSWORD=

# ---- 探测参数（默认即可，无需改动）----
NETLOG_PORT=3016
NETLOG_INTERVAL_MS=60000
NETLOG_TIMEOUT_MS=2500
NETLOG_FAIL_THRESHOLD=2
NETLOG_LAN_HOST=192.168.31.1
NETLOG_LAN_PORT=80
NETLOG_WAN_TARGETS=223.5.5.5:443,119.29.29.29:443
# 流量探测源（v9）：HTTP 全链路验证「用户意义上的网络可用」，多候选任一返回 204 即通过
#NETLOG_TRAFFIC_URLS=http://connect.rom.miui.com/generate_204,http://wifi.vivo.com.cn/generate_204
NETLOG_HEARTBEAT_MS=900000
NETLOG_EGRESS_INTERVAL_MS=1800000
NETLOG_EGRESS_URLS=http://members.3322.org/dyndns/getip,http://ip.3322.net,https://api.ipify.org

# ---- 数据落盘（默认 = ~/qianli-data/netlog/，部署目标上建议显式指到 C:/qianli/data/netlog）----
#NETLOG_DATA_DIR=C:/qianli/data/netlog

# ---- 复活引擎（v2）：账号池 + Dr.COM eportal 认证 ----
# 账号池文件（campus-accounts.local.json，凭据不进 git；部署目标=C:/qianli/data/netlog/ 下）
#NETLOG_ACCOUNT_POOL=C:/qianli/data/netlog/campus-accounts.local.json
# 手动复活端点 POST /api/netlog/revive 的鉴权 token（管理端点必须鉴权；留空=端点锁定）
NETLOG_API_TOKEN=
# 复活引擎总开关（默认开；false 退化回纯日志探针）
#NETLOG_REVIVE_ENABLED=1
# 认证服务器（默认重大 Dr.COM；端口 801 是 eportal API，不是登录页 80/443）
#NETLOG_AUTH_HOST=10.10.8.162
#NETLOG_AUTH_PORT=801
#NETLOG_AUTH_PAGE_HOST=login.cqu.edu.cn
# ---- 通知出口（v6，曼波拍板：不用 webhook，机器人本体私聊）----
# 共用应用凭据（对话型机器人同款应用；私聊发送走 IM API）
NETLOG_FEISHU_APP_ID=
NETLOG_FEISHU_APP_SECRET=
# 私聊目标 open_id（逗号分隔多个）
NETLOG_NOTIFY_OPEN_IDS=
# 播报总开关（v21）：留空/true=开启；false=即时私聊/积压补发全静默（事件流照落盘可回放）
NETLOG_NOTIFY_ENABLED=

# —— 路由器无线状态观测（v15）：主路由半死（射频信标不发/DHCP 僵死）有线侧感知不到，
# 登录 miwifi 低频拉射频状态补盲区；PASSWORD 未配置=观测停用
NETLOG_ROUTER_HOST=192.168.31.1
NETLOG_ROUTER_WATCH_INTERVAL_MS=600000
NETLOG_ROUTER_PASSWORD=
