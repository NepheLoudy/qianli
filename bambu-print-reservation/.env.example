# 服务器配置
PORT=3001

# 飞书配置（qianli 项目群共用应用；事件由 feishu-gateway 唯一长连接转发，本服务不开长连接）
APP_ID=cli_xxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_USE_LONG_CONNECTION=false

# 飞书多维表格配置
BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxx
BITABLE_RESERVATION_TABLE_ID=tblXXXXXXXXXXXXXX
BITABLE_PRINTER_TABLE_ID=tblXXXXXXXXXXXXXX

# 飞书事件订阅配置
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 飞书机器人配置
BOT_NAME=爆米花机-对话型
BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BOT_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# 打印机配置 (多台用逗号分隔，按位置对齐；X1/H2D 走 SFTP 22，P1/A1 走 FTP 21；
# 非 Bambu 机型如闪铸只登记展示，不参与自动分发)
PRINTER_HOSTS=192.168.1.100,192.168.1.101,192.168.1.102,192.168.1.103
PRINTER_ACCESS_CODES=xxxxxxxx,xxxxxxxx,xxxxxxxx,xxxxxxxx
PRINTER_SERIALS=SNxxxxxxxxx,SNxxxxxxxxx,SNxxxxxxxxx,SNxxxxxxxxx
PRINTER_NAMES=X1C-01,X1C-02,H2D,闪铸AD5M
# 机型名须命中 brandOf 口径（拓竹: X1C/P1S/A1/…；闪铸: AD5/5M/CREATOR 系，勿用 ADVENTURER5 这类不命中型号，会被误判为拓竹走 MQTT）
PRINTER_MODELS=X1C,X1C,H2D,AD5

# 审批者配置（指定成员open_id，逗号分隔）
REVIEWERS=ou_xxxxxxxxxxxxxxxx

# ---------------- 官方审批直连（⚠️ 2026-10-05 路线 A 已退役：整段保留备查，勿再配置） ----------------
# 自建前后端为唯一预约/审批通道：真相源 = RESERVATIONS_STORE_FILE，审批走页面 + X-API-Token，
# 飞书仅剩群 webhook 播报（BOT_WEBHOOK_URL）。以下审批事件/自动审批/对账配置已无代码消费。
# 审批实例事件（approval_instance）秒级驱动分发；多维表格仅是半小时级同步镜像
APPROVAL_PRIMARY=true
# 审批定义 code（审批管理后台可查）。留空 = 不过滤：网关会把共用应用的全部审批实例
# 事件转发到本服务，任何「已通过且含附件」的审批都会被当成打印申请下发到真机，务必配置
APPROVAL_CODE=
# （拿到 code 后一次性订阅：node -e "require('./src/services/approvalService').subscribeApproval('<code>')"）
# 审批事件丢失自愈：每 N 分钟对账补入队（含拉详情失败重拉）；0 = 关闭
APPROVAL_RECONCILE_MINUTES=5
# 对账回看窗口（分钟，按实例提交时间）；窗口列表兜底需配置 APPROVAL_CODE（列表接口必须指定审批定义）
APPROVAL_RECONCILE_WINDOW_MINUTES=1440

# ---------------- 分发引擎 ----------------
# 审批表单字段名（与多维表格字段一致）
DISPATCH_MATERIAL_FIELD=材料类型
DISPATCH_COLOR_FIELD=颜色
DISPATCH_PRINTER_FIELD=指定打印机
# 颜色近似匹配阈值（redmean 距离 0-765，越大越宽松）
DISPATCH_COLOR_THRESHOLD=120
# 对账兜底间隔（分钟）：仅后备模式（APPROVAL_PRIMARY=false）生效，主通道下对账关闭、此配置无效
DISPATCH_RECONCILE_MINUTES=2
# 缺料提醒重发间隔（分钟）
DISPATCH_MATERIAL_REMIND_MINUTES=30
# 打印是否由 AMS 供料
DISPATCH_USE_AMS=true
# 分发失败重试上限（超过后退出队列转人工）
DISPATCH_MAX_RETRIES=3
# 分发失败重试冷却（毫秒）
DISPATCH_RETRY_COOLDOWN_MS=60000

# ---------------- NAS 部署配置（push.js 用，严禁提交） ----------------
# NAS_* 为历史命名，语义=部署目标（小电脑 DESKTOP-FE1MIGI）
DEPLOY_HOST=192.168.31.57
DEPLOY_PORT=22
DEPLOY_USER=mechax
DEPLOY_PASSWORD=

# 自动审批：审批流「自动审批」节点审批人 open_id，机器人按 AMS 匹配规则自动同意；留空 = 不自动审批
APPROVAL_AUTO_APPROVER_ID=

# ---------------- 晚间静默（播报时段限制） ----------------
# 播报静默窗口 [START, END)（Asia/Shanghai 整点）：窗口内定时/自动播报不直接发送，
# 积压到 END 整点统一补发（任务类重跑取补发时刻数据；一次性通知原样补发）。
# 对话/指令回复与人工当下主动触发不受限。默认 2→9，留空即默认。
# QUIET_HOURS_START=2
# QUIET_HOURS_END=9
# QUIET_HOURS_DISABLED=1
# 静默积压文件（显式配到项目外数据目录：SFTP 部署清目录不再丢积压；目录不存在会自建）
QUIET_BACKLOG_FILE=C:/home/qianli/bambu-data/.quiet-backlog.json
# 分发引擎状态文件（队列/打印中/已知记录，重启恢复；放项目外防部署清目录丢失；带盘符）
DISPATCH_STATE_FILE=C:/home/qianli/bambu-data/dispatch-state.json
# ---------------- 自建前后端（2026-10-05 路线 A 主通道） ----------------
# 预约记录真相源（本地 JSON；放项目外防部署清目录丢失；带盘符）
RESERVATIONS_STORE_FILE=C:/home/qianli/bambu-data/reservations.json
# 上传文件目录（源模型/切片文件；带盘符）
RESERVATIONS_UPLOAD_DIR=C:/home/qianli/bambu-data/uploads/
# 账号存储（注册/登录/scrypt 口令哈希/会话；放项目外防部署清目录丢失；带盘符）
AUTH_STORE_FILE=C:/home/qianli/bambu-data/auth-users.json
# 工艺映射规则库文件（热改写回；放项目外防部署清目录丢失；带盘符）
PROCESS_RULES_FILE=C:/home/qianli/bambu-data/process-rules.json

# ---------------- 动态广场事件流（机器人项目看板「动态广场」表；表 id 可用 env 覆盖，默认值已内置 config） ----------------
# 动态广场事件流开关（2026-09-20 拍板：广场由用户自维护，机器人默认停写；设 1 才恢复机器人写入）
# PLAZA_ENABLED=0
# PLAZA_BITABLE_APP_TOKEN=ZlVZbXDkRayUzSsFRiycznmZn5b
# PLAZA_BITABLE_TABLE_ID=tbld1zHXkTzko20p

# 管理端点鉴权（2026-09-13，全局共享值）：写端点需 X-API-Token 头；未配置 = 写端点锁定
# 生成：openssl rand -hex 24（全工作区共享同一值，运维台代理自动带头）
API_TOKEN=
# 数据面每日快照目录（预约/账号/规则/建议四 JSON；默认数据目录同盘 backup/；保留天数可调）
# BACKUP_DIR=C:/home/qianli/bambu-data/backup
# BACKUP_KEEP_DAYS=14
# 使用上报端点（网关使用统计归因；默认同机网关 3010；置空关闭上报）
# USAGE_REPORT_URL=http://127.0.0.1:3010/api/usage/report
# 摆向学习策略工件（candidate/adopted，部署清目录不丢）
ORIENTATION_POLICY_FILE=C:/home/qianli/bambu-data/orientation-policy.json
