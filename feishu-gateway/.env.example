# ---------------- 服务 ----------------
PORT=3010

# ---------------- 飞书应用（qianli 项目群共用应用） ----------------
# 注意：本网关是唯一持有长连接的进程，各机器人必须设置 FEISHU_USE_LONG_CONNECTION=false
APP_ID=cli_aac7e6f6cdf8dcc0
APP_SECRET=

# ---------------- 事件订阅 ----------------
# 长连接订阅的事件类型（逗号分隔），接入新事件类型在这里加
# drive.file.bitable_field_changed_v1=多维表格字段结构变更（无消费方，注册后静默忽略，防 SDK warn 刷屏）
EVENT_TYPES=im.message.receive_v1,drive.file.bitable_record_changed_v1,approval_instance,approval_task,drive.file.bitable_field_changed_v1

# ---------------- 下游机器人消费者 ----------------
# 格式：名称|事件回调URL|指令转发URL(可选)|标记(可选)
# 标记 legacy = 按旧版事件结构（bitable.record.create/update + record.fields）转发该机器人
# bambu 已随 v35 退网（路线 A 页面审批直连，不再消费表格事件）；如需恢复在末尾追加：
#   ;bambu|http://localhost:3001/api/feishu/event|http://localhost:3001/api/chat/command|legacy
CONSUMERS=hub|http://localhost:3000/api/feishu/event;approval|http://localhost:3002/api/feishu/event|http://localhost:3002/api/chat/command;ticket|http://localhost:3003/api/feishu/event

# ---------------- 消息事件路由 ----------------
# JSON 数组，按顺序匹配，命中即停；全部未命中转发给 DEFAULT_TARGET（event 模式）
# match 字段：chatId / chatType / mention / prefix / contains（同一规则内 AND 关系）
# mode：event=转发原始事件到事件回调；command=解析 /指令 后 POST 到指令端点，由网关代为回复结果
# 示例（优先级从高到低）：
# MESSAGE_ROUTES=[{"match":{"chatId":"oc_xxx"},"target":"approval","mode":"event"},{"match":{"prefix":"/approval"},"target":"approval","mode":"command"}]
MESSAGE_ROUTES=
DEFAULT_TARGET=hub

# ---------------- 多维表格事件 ----------------
# 广播目标（逗号分隔消费者名，留空=全部消费者；各机器人按 table_id 自行过滤）
BITABLE_TARGETS=
# 需要订阅记录变更的云文档 appToken（逗号分隔，网关启动时幂等调用订阅接口）
DOC_SUBSCRIBES=

# ---------------- 审批事件（approval_instance / approval_task） ----------------
# 转发目标（逗号分隔消费者名，留空 = ticket：工单接单联动；bambu 打印审批链已随 v35 退役）
APPROVAL_TARGETS=

# ---------------- 透传给机器人的校验token（可选） ----------------
FEISHU_VERIFICATION_TOKEN=

# ---------------- 管理端点鉴权（2026-09-13） ----------------
# /api/dispatch、/api/usage-sync/run、/api/usage/report 需带 X-API-Token 头；未配置 = 三端点整体锁定（fail-closed）
# 生成：openssl rand -hex 24；调用示例：curl -X POST -H "X-API-Token: <token>" http://127.0.0.1:3010/api/usage-sync/run?force=1
GATEWAY_API_TOKEN=

# ---------------- 长连接巡检与数据目录 ----------------
WS_CONNECTING_GIVE_UP_MS=300000   # connecting 恒挂兜底阈值（默认 5 分钟，超时进程自退待 pm2 重建）
GATEWAY_DATA_DIR=                 # 使用统计/同步状态落盘目录（默认项目内；现网外迁 .data）

# ---------------- 部署配置（push.js 用，严禁提交；NAS_ 为历史命名，语义=部署目标=小电脑 DESKTOP-FE1MIGI） ----------------
DEPLOY_HOST=192.168.31.57
DEPLOY_PORT=22
DEPLOY_USER=mechax
DEPLOY_PASSWORD=

# ---------------- 动态广场看板：网关日活跃同步（机器人项目看板多维表格，可选） ----------------
# 配置后每 30 分钟把使用统计（口径=机器人交互）upsert 到 网关日活跃 单表
# （网关功能使用/网关队员活跃两表已下线，2026-09-13）
# PLAZA_BITABLE_APP_TOKEN=
# PLAZA_BITABLE_DAILY_TABLE=
